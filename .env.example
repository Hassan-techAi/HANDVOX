# APP_URL: Public URL of this application (used for Supabase Auth redirect URLs).
APP_URL="MY_APP_URL"
# PUBLIC_APP_URL (optional): Deployed public origin for external meeting invitation links when developing inside preview.
PUBLIC_APP_URL=""
VITE_PUBLIC_APP_URL=""

# =========================================================
# SUPABASE CONFIGURATION (Required)
# =========================================================
# Frontend-safe variables (exposed to Vite client bundle):
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only variables (NEVER prefix with VITE_ and NEVER expose in frontend code):
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# =========================================================
# OWNER ACCOUNT BOOTSTRAP (Recommended for /admin initial setup)
# =========================================================
# Public registration NEVER automatically grants admin privileges.
OWNER_BOOTSTRAP_EMAIL=""
OWNER_BOOTSTRAP_SECRET=""

# =========================================================
# AI COMMUNICATION ASSISTANT (Optional Server-Side Gemini)
# =========================================================
GEMINI_API_KEY=""

# =========================================================
# LIVE VIDEO MEETINGS (WebRTC SFU / TURN - Optional for Scale)
# =========================================================
# If LIVEKIT_URL, LIVEKIT_API_KEY, and LIVEKIT_API_SECRET are set,
# HANDVOX uses LiveKit SFU for scalable multi-user video rooms.
# Otherwise, HANDVOX uses its built-in WebSocket (/ws/meetings) WebRTC signaling.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Optional TURN server for restrictive corporate/mobile firewalls:
WEBRTC_TURN_URL=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""

# Optional HMAC secret for short-lived meeting room access tokens:
MEETING_TOKEN_SECRET=""
